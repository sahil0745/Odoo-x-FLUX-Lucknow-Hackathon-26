# ==============================================================================
# Brightloop Subscription Management System — Monorepo Environment Configuration
# ==============================================================================
# Copy this file to backend/.env and frontend/.env as appropriate.
# DO NOT commit real secrets or credentials into version control.

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop_subscriptions?schema=public

# Authentication & Security
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_characters_long_replace_in_prod
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_characters_long_replace_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_APP_NAME="Brightloop Subscription Management System"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_APP_ENV="development"
